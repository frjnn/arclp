# Selects the dense-kernel backend behind src/dense/dense.h.
# Sets ARCLP_DENSE_SOURCE, ARCLP_BLAS_LIBRARIES and ARCLP_BLAS_INCLUDE_DIRS.

set(ARCLP_BLAS_LIBRARIES "")
set(ARCLP_BLAS_INCLUDE_DIRS "")
set(_arclp_backend "${ARCLP_BLAS}")

if(_arclp_backend STREQUAL "auto")
    if(APPLE)
        set(_arclp_backend accelerate)
    else()
        find_package(BLAS QUIET)
        find_path(ARCLP_CBLAS_INCLUDE_DIR cblas.h PATH_SUFFIXES openblas)
        if(BLAS_FOUND AND ARCLP_CBLAS_INCLUDE_DIR)
            set(_arclp_backend cblas)
        else()
            set(_arclp_backend none)
        endif()
    endif()
endif()

if(_arclp_backend STREQUAL "accelerate")
    find_library(ARCLP_ACCELERATE Accelerate REQUIRED)
    set(ARCLP_DENSE_SOURCE dense/dense_blas.c dense/blas_threading.c)
    set(ARCLP_BLAS_LIBRARIES "${ARCLP_ACCELERATE}")
elseif(_arclp_backend STREQUAL "cblas")
    find_package(BLAS REQUIRED)
    find_path(ARCLP_CBLAS_INCLUDE_DIR cblas.h PATH_SUFFIXES openblas REQUIRED)
    set(ARCLP_DENSE_SOURCE dense/dense_blas.c dense/blas_threading.c)
    set(ARCLP_BLAS_LIBRARIES BLAS::BLAS)
    set(ARCLP_BLAS_INCLUDE_DIRS "${ARCLP_CBLAS_INCLUDE_DIR}")
elseif(_arclp_backend STREQUAL "none")
    set(ARCLP_DENSE_SOURCE dense/dense_ref.c)
else()
    message(FATAL_ERROR "ARCLP_BLAS must be auto, accelerate, cblas or none")
endif()

set(ARCLP_BLAS_BACKEND "${_arclp_backend}")
message(STATUS "arclp dense kernels: ${ARCLP_BLAS_BACKEND}")
